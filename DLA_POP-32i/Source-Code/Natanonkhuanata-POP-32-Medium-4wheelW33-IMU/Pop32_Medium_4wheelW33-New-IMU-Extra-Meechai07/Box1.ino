void Box1()
{
  ForwardSpeedTime(Speed,200);
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracJC1(); 
  TurnLeft();
  BackwardBalance();
  TracJC1(); 
  TurnLeft();
  BackwardBalance();
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracJC1(); 
  TurnRight();
  TracJC1();
  TracJC1Back();
  TurnLeft();
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracJC1(); 
  TurnLeft();
  BackwardBalance();
  TracJC1(); 
  TurnLeft();  
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracJC1(); 
  KickF(); 
}
void Box1Acc()
{
  ForwardSpeedTime(ACCSpeed,250);
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracACC(ACCSpeed,300);
  TracJC1(); 
  TurnLeft();
  BackwardBalance();
  TracACC(ACCSpeed,300);
  TracJC1(); 
  TurnLeft();
  BackwardBalance();
  TracACC(ACCSpeed,300);
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracACC(ACCSpeed,550);
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracACC(ACCSpeed,550);
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracACC(ACCSpeed,300);
  TracJC1();
  MotorStop(); delay(100); 
  TurnRight();
  TracACC(ACCSpeed,200);
  TracJC1();
  TracACCBack(ACCSpeed,400);
  TracJC1Back();
  TurnLeft();
  TracACC(ACCSpeed,200);
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracACC(ACCSpeed,300);
  TracJC1(); 
  TurnLeft();
  BackwardBalance();
  TracACC(ACCSpeed,550);
  TracJC1(); 
  TurnLeft(); 
  TracACC(ACCSpeed,200); 
  TracJC1(); 
  TurnRight();
  BackwardBalance();
  TracACC(ACCSpeed,650);
  TracJC1(); 
  KickF();  
}
