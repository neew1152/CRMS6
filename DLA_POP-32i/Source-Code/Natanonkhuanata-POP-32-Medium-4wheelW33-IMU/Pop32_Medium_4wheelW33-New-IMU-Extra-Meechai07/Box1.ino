void Box1Speed()
{
  TracDegreeSpeedTime(ACCSpeed,0,180,0);
  CurveRightDegree(100,275,1);
  TracDegreeSpeedTime(ACCSpeed,270,100,0);
  CurveLeftDegree(100,355,1); 
  TracDegreeSpeedTime(ACCSpeed,0,150,0); 
  CurveLeftDegree(100,85,1);
  TracDegreeSpeedTime(ACCSpeed,90,100,0);  
  CurveRightDegree(100,5,1);
  TracDegreeSpeedTime(ACCSpeed,5,390,0);  
  CurveRightDegree(100,275,1); 
  TracDegreeSpeedTime(ACCSpeed,270,380,0); 
  CurveRightDegree(100,185,1);
  TracDegreeSpeedTime(ACCSpeed,180,120,0); 
  CurveRightDegree(100,95,1);
  TracDegreeSpeedTime(ACCSpeed,90,150,0); 
  MotorStop(); 
  delay(50);
  TracDegreeSpeedTimeBack(ACCSpeed,90,400,0);
  CurveRightDegreeBack(100,5,1); 
  TracDegreeSpeedTimeBack(ACCSpeed,0,130,0); 
  CurveRightDegreeBack(100,275,1); 
  TracDegreeSpeedTimeBack(ACCSpeed,270,100,0); 
  CurveLeftDegreeBack(100,355,1); 
  TracDegreeSpeedTimeBack(ACCSpeed,0,400,0); 
  CurveLeftDegreeBack(100,85,1); 
  TracDegreeSpeedTimeBack(ACCSpeed,90,140,0); 
  CurveRightDegreeBack(100,10,1); 
  TracDegreeSpeedTimeBack(ACCSpeed,5,600,0); 
  TracJCStopBack(); 
  KickBForwardDegree(ACCSpeed,5,420);     
}
void Box1CurveAcc()
{
  ForwardSpeedTime(ACCSpeed,180);
  CurveRightDegree(100,275,1); 
  TracSpeedTime(ACCSpeed,100); 
  CurveLeftDegree(100,355,1); 
  TracSpeedTime(ACCSpeed,120);
  CurveLeftDegree(100,85,1); 
  TracSpeedTime(ACCSpeed,110);
  CurveRightDegree(100,12,1); 
  TracSpeedTime(ACCSpeed,370);
  CurveRightDegree(100,282,1); 
  TracSpeedTime(ACCSpeed,380);
  CurveRightDegree(100,190,1); 
  TracSpeedTime(ACCSpeed,180);
  TracJC(); 
  TurnRightDegree(100,108,1); 
  TracSpeedTime(ACCSpeed,250); 
  MotorStop(); delay(100);
  TracACCBack(40,100); 
  TracACCBack(ACCSpeed,400);
  TracJC1Back(); 
  TurnLeftDegree(100,170,1);
  TracSpeedTime(ACCSpeed,160);
  CurveRightDegree(100,100,1); 
  TracSpeedTime(ACCSpeed,100);
  CurveLeftDegree(100,175,1); 
  TracSpeedTime(ACCSpeed,330);
  CurveLeftDegree(100,260,1); 
  TracSpeedTime(ACCSpeed,120); 
  TracJC1(); 
  TurnRightDegree(100,197,1); 
  //CurveRightDegree(100,193,1); 
  TracSpeedTime(ACCSpeed,500);
  TracJCStop(); 
  KickFBackward();   
}
